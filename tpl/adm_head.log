        <nav class="nav-desktop">
            <?php
            if (file_exists($menuFile)) {
                $menuLines = file($menuFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
                foreach ($menuLines as $line) {
                    $line = trim($line);
                    if (empty($line)) continue;
                    $parts = explode('|', $line);
                    if (count($parts) < 3) continue;
                    $itemLevel = intval(trim($parts[0]));
                    if (isset($authUserlevel) && $authUserlevel < $itemLevel) continue;
                    $menuText = trim($parts[1]);
                    $menuLink = trim($parts[2]);
                    if (empty($menuText) || empty($menuLink)) continue;
                    echo '<a href="' . htmlspecialchars($menuLink, ENT_QUOTES, 'UTF-8') . '">';
                    echo htmlspecialchars($menuText, ENT_QUOTES, 'UTF-8');
                    echo '</a>';
                }
            }
            ?>
            <a href="login.php?logout=out" class="logout-btn">LOGOUT</a>
        </nav>

        <!-- Mobile Toggle -->
        <button class="menu-toggle" onclick="document.getElementById('navMobile').classList.toggle('active')" aria-label="Menu">&#9776;</button>
    </div>

    <!-- Mobile Menu -->
    <nav id="navMobile" class="nav-mobile">
