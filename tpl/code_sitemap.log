<?php
header('Content-Type: application/xml; charset=utf-8');
echo '<?xml version="1.0" encoding="UTF-8"?>' . "\n";
echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">' . "\n";

$files = [
    __DIR__ . '/../data/sitemap_manual.log',
    __DIR__ . '/../data/sitemap_tag.log',
    __DIR__ . '/../data/sitemap_info.log',
];

foreach ($files as $file) {
    if (!file_exists($file)) continue;
    foreach (file($file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $parts = explode('|', $line, 4);
        if (empty($parts[0])) continue;
        echo "  <url>\n    <loc>" . htmlspecialchars($parts[0], ENT_QUOTES, 'UTF-8') . "</loc>\n";
        if (!empty($parts[1])) echo "    <lastmod>" . trim($parts[1]) . "</lastmod>\n";
        if (!empty($parts[2])) echo "    <changefreq>" . trim($parts[2]) . "</changefreq>\n";
        if (!empty($parts[3])) echo "    <priority>" . trim($parts[3]) . "</priority>\n";
        echo "  </url>\n";
    }
}

echo '</urlset>';
