</head>
<body class="<?php echo htmlspecialchars($bodyClass, ENT_QUOTES, 'UTF-8'); ?>">
<!-- Top Bar -->
<header class="site-header">
    <div class="header-inner">
        <button class="menu-toggle" onclick="document.getElementById('navMain').classList.toggle('active')" aria-label="Menu">&#9776;</button>
        <div class="site-logo"><a href="{sys_site_weburl}">{sys_site_name}</a></div>
        <nav id="navMain" class="nav-main">{site:menu}</nav>
    </div>
</header>
<!-- Content Start -->
<div class="site-container">  <div class=path><a href="{sys_site_weburl}">{sys_site_name}</a>{site:path} &raquo; {code:code_title}</div>
