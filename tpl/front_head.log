<?php
/**
 * NoDB-WebBase
 * GitHub: https://github.com/max-godman

 * Front-end Page Head Template
 *
 * Required variables:
 *   $pageTitle       - Page title
 *   $pageDescription - Page description
 *   $pageType       - Page type (optional, for body class)
 *   $siteNavItems   - Navigation items array (prepared by index.php)
 *   $currentPath    - Current request path (for nav highlighting)
 *
 */

$bodyClass = isset($pageType) ? 'page-' . $pageType : '';
?>
<!DOCTYPE html>
<html lang="<?php echo $sysConfig['sys_site_language']; ?>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<?php echo isset($pageDescription) ? htmlspecialchars($pageDescription, ENT_QUOTES, 'UTF-8') : ''; ?>">
    <title><?php echo isset($pageTitle) ? htmlspecialchars($pageTitle, ENT_QUOTES, 'UTF-8') : 'Untitled'; ?> - {sys_site_name}</title>
    <link rel="stylesheet" href="pics/style.css">
</head>
<body class="<?php echo htmlspecialchars($bodyClass, ENT_QUOTES, 'UTF-8'); ?>">

<!-- Top Bar -->
<header class="site-header">
    <div class="header-inner">
        <div class="site-logo">
            <a href="<?php echo $sysConfig['sys_site_weburl']; ?>">{sys_site_name}</a>
        </div>

        <!-- Desktop Nav -->
        <nav class="nav-desktop">
            <?php
            if (!empty($siteNavItems)):
                foreach ($siteNavItems as $item):
                    $isActive = ($currentPath === $item['link'] || ($currentPath === '' && $item['link'] === '/'));
                    $activeClass = $isActive ? 'active' : '';
            ?>
            <a href="<?php echo htmlspecialchars($item['link'], ENT_QUOTES, 'UTF-8'); ?>" class="<?php echo $activeClass; ?>">
                <?php echo htmlspecialchars($item['text'], ENT_QUOTES, 'UTF-8'); ?>
            </a>
            <?php
                endforeach;
            endif;
            ?>
        </nav>

        <!-- Mobile Toggle -->
        <button class="menu-toggle" onclick="document.getElementById('navMobile').classList.toggle('active')" aria-label="Menu">&#9776;</button>
    </div>

    <!-- Mobile Nav -->
    <nav id="navMobile" class="nav-mobile">
        <?php
        if (!empty($siteNavItems)):
            foreach ($siteNavItems as $item):
                $isActive = ($currentPath === $item['link'] || ($currentPath === '' && $item['link'] === '/'));
                $activeClass = $isActive ? 'active' : '';
        ?>
        <a href="<?php echo htmlspecialchars($item['link'], ENT_QUOTES, 'UTF-8'); ?>" class="<?php echo $activeClass; ?>">
            <?php echo htmlspecialchars($item['text'], ENT_QUOTES, 'UTF-8'); ?>
        </a>
        <?php
            endforeach;
        endif;
        ?>
    </nav>
</header>

<!-- Content Start -->
<div class="site-container">
    <main>
